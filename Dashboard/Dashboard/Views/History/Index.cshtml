@model HistoryViewModel
@{
    ViewData["Title"] = "History";
}
@functions {
    // Builds a link that keeps the current filters and overrides only what's passed in.
    string Link(string? strategy = null, string? sort = null, int page = 1) =>
        Url.Action("Index", "History", new
        {
            strategy = strategy ?? Model.StrategyFilter,
            from = Model.From,
            to = Model.To,
            sort = sort ?? Model.Sort,
            page
        })!;

    string Chip(bool active) => active ? "chip chip-active" : "chip";

    string StrategyClass(AlgoData.Models.StrategyType s) => s switch
    {
        AlgoData.Models.StrategyType.Breakout => "st-chip st-breakout",
        AlgoData.Models.StrategyType.Macd => "st-chip st-macd",
        AlgoData.Models.StrategyType.Reversal => "st-chip st-reversal",
        _ => "st-chip st-ema"
    };
}

<header class="ct-head">
    <div>
        <div class="ct-eyebrow">Closed trades</div>
        <h1 class="ct-title">History</h1>
    </div>
    <form method="get" asp-controller="History" asp-action="Index" class="ct-daterange">
        <input type="hidden" name="strategy" value="@Model.StrategyFilter" />
        <input type="hidden" name="sort" value="@Model.Sort" />
        <label>From <input type="date" class="ct-input" name="from" value="@Model.From" /></label>
        <label>To <input type="date" class="ct-input" name="to" value="@Model.To" /></label>
        <button type="submit" class="ct-btn ct-btn-primary border-0">Apply</button>
        @if (Model.From != "" || Model.To != "")
        {
            <a class="ct-btn" href="@Url.Action("Index", "History", new { strategy = Model.StrategyFilter, sort = Model.Sort })">Clear</a>
        }
    </form>
</header>

@if (Model.Error is not null)
{
    <div class="alert alert-warning py-2 mb-0" role="alert">@Model.Error</div>
}

@* ---------- Total P&L for the current filter ---------- *@
<section class="ct-card ct-stat ct-stat-inline">
    <span class="ct-stat-label">Total P&amp;L</span>
    <span class="ct-stat-value @Display.PnlClass(Model.TotalPnl)">@Display.Money(Model.TotalPnl)</span>
    <span class="ct-sub">@Model.TotalRows closed @(Model.TotalRows == 1 ? "trade" : "trades") in this view</span>
</section>

@* ---------- Trades ---------- *@
<section class="d-flex flex-column gap-3">
    <div class="ct-toolbar">
        <h2 class="ct-section-title">Trades</h2>
        <div class="chip-group">
            <a class="@Chip(Model.StrategyFilter == "all")" href="@Link(strategy: "all")">All</a>
            <a class="@Chip(Model.StrategyFilter == "ema")" href="@Link(strategy: "ema")">EMA</a>
            <a class="@Chip(Model.StrategyFilter == "breakout")" href="@Link(strategy: "breakout")">Breakout</a>
            <a class="@Chip(Model.StrategyFilter == "macd")" href="@Link(strategy: "macd")">MACD</a>
            <a class="@Chip(Model.StrategyFilter == "reversal")" href="@Link(strategy: "reversal")">Reversal</a>
        </div>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="ct-card empty-state">
            @if (Model.Error is null)
            {
                @:No closed trades match these filters.
            }
            else
            {
                @:Could not load data.
            }
        </div>
    }
    else
    {
        var pnlNextSort = Model.Sort == "pnl_desc" ? "pnl_asc" : "pnl_desc";

        <div class="ct-card ct-table-wrap">
            <table class="ct-table ct-compact">
                <thead>
                    <tr>
                        <th><a class="sort-link" href="@Link(sort: "time")">Closed @(Model.Sort == "time" ? "▼" : "")</a></th>
                        <th>Strategy</th>
                        <th>Instrument</th>
                        <th>Entry &rarr; Exit</th>
                        <th>Held</th>
                        <th class="text-end"><a class="sort-link" href="@Link(sort: pnlNextSort)">P&amp;L @(Model.Sort == "pnl_desc" ? "▼" : Model.Sort == "pnl_asc" ? "▲" : "")</a></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <div class="num" style="font-size:14px">@(r.ExitTime?.ToString("dd MMM, hh:mm tt") ?? "—")</div>
                                <div class="ct-sub">#@r.Id</div>
                            </td>
                            <td>
                                <span class="@StrategyClass(r.Strategy)">@Display.Strategy(r.Strategy)</span>
                                @if (r.Leg is not null)
                                {
                                    <div class="ct-sub mt-1">@Display.Leg(r.Leg)</div>
                                }
                            </td>
                            <td class="text-nowrap">
                                <div class="ct-sym">@r.TradingSymbol</div>
                                <div class="ct-sub @(Display.IsBullish(r.Direction) ? "dir-up" : "dir-down")" title="@r.ExitReason">@Display.DirectionLabel(r.Direction)</div>
                            </td>
                            <td class="text-nowrap num" style="font-size:14px">
                                &#8377;@Display.Number(r.EntryPremium) &rarr; @(r.ExitPremium is { } ex ? "₹" + Display.Number(ex) : "—")
                                @if (r.StopLossPremium is { } slp)
                                {
                                    <div class="ct-sub">Final SL &#8377;@Display.Number(slp)</div>
                                }
                                else if (r.StopLossSpot is { } sls)
                                {
                                    <div class="ct-sub">Final SL Nifty @Display.Number(sls)</div>
                                }
                            </td>
                            <td class="text-nowrap num ct-sub">@Display.Duration(r.Held)</td>
                            <td class="text-end text-nowrap num">
                                <span class="fw-semibold @Display.PnlClass(r.FinalPnlRupees)" style="font-size:15px">@Display.Money(r.FinalPnlRupees)</span>
                                <div class="ct-sub @Display.PnlClass(r.FinalPnlRupees)">@Display.Pct(r.FinalPnlPercent)</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pager" model="@(new PagerModel(Model.Page, Model.TotalPages, Model.TotalRows, Model.PageSize, p => Link(page: p)))" />
    }
</section>

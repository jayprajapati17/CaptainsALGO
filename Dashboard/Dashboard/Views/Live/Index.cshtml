@model LiveIndexViewModel
@{
    ViewData["Title"] = "Live";
}

<div id="liveRoot" class="d-flex flex-column gap-4"
     data-hub-url="@Model.PositionsHubUrl"
     data-close-url="@Url.Action("Close", "Live")"
     data-open-url="@Url.Action("Open", "Live")"
     data-initial-risk="@Model.InitialRiskPoints.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
     data-target-points="@Model.TargetPoints.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
     data-cpr-bc="@(Model.Cpr is { } c0 ? c0.Bc.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
     data-cpr-tc="@(Model.Cpr is { } c1 ? c1.Tc.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")">

    <header class="ct-head">
        <div>
            <div class="ct-eyebrow">@DateTime.Now.ToString("ddd, dd MMM yyyy")</div>
            <h1 class="ct-title">Live desk</h1>
        </div>
        <div class="ct-pill" id="hubPill">
            <span class="status-dot status-connecting" id="hubDot"></span>
            <span id="hubStatus">Connecting...</span>
        </div>
    </header>

    @if (Model.WorkerError is not null)
    {
        <div class="alert alert-warning py-2 mb-0" role="alert">@Model.WorkerError</div>
    }

    @* ---------- Market band ---------- *@
    <section class="ct-grid">
        <div class="ct-card ct-stat">
            <span class="ct-stat-label">Nifty 50</span>
            <span class="ct-stat-value" id="niftySpot">--</span>
            <span class="ct-stat-sub">Live spot</span>
        </div>

        <div class="ct-card ct-stat" style="gap:14px">
            <div class="d-flex justify-content-between align-items-center">
                <span class="ct-stat-label">
                    @(Model.Cpr is { IsForToday: false } ? "CPR (" + Model.Cpr.ForTradingDay.ToString("dd MMM") + ")" : "Today's CPR")
                </span>
                @if (Model.Cpr is { } cprBadge)
                {
                    <span class="cpr-badge" title="@cprBadge.BiasNote">@cprBadge.Reading &middot; @cprBadge.WidthPercent.ToString("0.00")%</span>
                }
            </div>
            @if (Model.Cpr is { } cpr)
            {
                <div class="cpr-bar" id="cprBar">
                    <div class="cpr-track"></div>
                    <div class="cpr-range" id="cprRange" style="left:30%;width:40%"></div>
                    <div class="cpr-spot d-none" id="cprSpot"></div>
                </div>
                <div class="cpr-levels">
                    <span title="Bottom central">BC @cpr.Bc.ToString("N2")</span>
                    <span title="Pivot">P @cpr.Pivot.ToString("N2")</span>
                    <span title="Top central">TC @cpr.Tc.ToString("N2")</span>
                </div>
            }
            else
            {
                <span class="ct-sub">Not available yet</span>
            }
        </div>

        <div class="ct-card ct-stat ct-stat-accent">
            <span class="ct-stat-label">Open P&amp;L</span>
            <span class="ct-stat-value" id="totalPnl">&#8377;0.00</span>
            <span class="ct-stat-sub"><span id="openCount">0</span> open positions &middot; 1 lot each</span>
        </div>
    </section>

    @* ---------- Positions ---------- *@
    <section class="d-flex flex-column gap-3">
        <div class="ct-toolbar">
            <h2 class="ct-section-title">Open positions</h2>
            <div class="chip-group" id="strategyFilter">
                <a href="#" class="chip chip-active" data-filter="all">All</a>
                <a href="#" class="chip" data-filter="Ema">EMA</a>
                <a href="#" class="chip" data-filter="Breakout">Breakout</a>
                <a href="#" class="chip" data-filter="Macd">MACD</a>
                <a href="#" class="chip" data-filter="Reversal">Reversal</a>
            </div>
        </div>

        <div id="emptyState" class="ct-card empty-state d-none">
            No open positions right now. A new row will appear here automatically when a signal fires.
        </div>

        <div class="ct-card ct-table-wrap" id="positionTableWrap">
            <table class="ct-table live-table">
                <thead>
                    <tr>
                        <th>Instrument</th>
                        <th>Entry time</th>
                        <th style="width:34%">Entry &rarr; LTP</th>
                        <th>Stop-loss</th>
                        <th class="text-end">P&amp;L</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="positionGrid"></tbody>
            </table>
        </div>

        <div class="gauge-legend">
            <span><i style="background:var(--loss)"></i>Stop-loss</span>
            <span><i style="background:var(--ink)"></i>Entry</span>
            <span><i style="background:var(--amber)"></i>Target (+<span id="targetLegend">@Model.TargetPoints.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</span>)</span>
        </div>
    </section>
</div>

<script type="application/json" id="initialPositions">@Html.Raw(Json.Serialize(Model.Positions))</script>

@section Scripts {
    @* signalr.min.js is loaded once, globally, from _Layout.cshtml (the token widget needs it on every page). *@
    <script src="~/js/live.js" asp-append-version="true"></script>
}

@inject WorkerEndpoints WorkerEndpoints
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NiftyBot Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Live" asp-action="Index">
                <span class="brand-mark">N</span>
                <span class="brand-word">NiftyBot</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto nb-tabs">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Live" ? "active" : "")" asp-controller="Live" asp-action="Index">Live</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "History" ? "active" : "")" asp-controller="History" asp-action="Index">History</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Signals" ? "active" : "")" asp-controller="Signals" asp-action="Index">Signals Log</a>
                    </li>
                </ul>

                @* ---- Task 9: Upstox daily token, shown/updated on every page ---- *@
                <div id="tokenWidget"
                     class="d-flex align-items-center"
                     data-status-url="@WorkerEndpoints.TokenStatusUrl"
                     data-authorize-url="@WorkerEndpoints.TokenAuthorizeUrl"
                     data-hub-url="@WorkerEndpoints.PositionsHubUrl">
                    <span class="small text-secondary">Checking token...</span>
                </div>
            </div>
        </div>
    </nav>

    <main class="container-fluid pb-5">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/token.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

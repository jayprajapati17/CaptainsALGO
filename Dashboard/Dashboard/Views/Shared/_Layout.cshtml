@inject WorkerEndpoints WorkerEndpoints
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string name) => currentController == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Captain's Trail</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700&family=Figtree:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="ct-shell">
        <aside class="ct-rail">
            <a class="ct-brand" asp-controller="Live" asp-action="Index">
                <span class="ct-brand-mark">C</span>
                <span class="ct-brand-text">
                    <span class="ct-brand-name">Captain's Trail</span>
                    <span class="ct-brand-sub">Paper trading desk</span>
                </span>
            </a>

            <nav class="ct-nav">
                <a class="@Active("Live")" asp-controller="Live" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>Live</a>
                <a class="@Active("History")" asp-controller="History" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>History</a>
                <a class="@Active("Signals")" asp-controller="Signals" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h10M4 18h6"/></svg>Signals Log</a>
                <a class="@Active("Settings")" asp-controller="Settings" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1.2l2-1.5-2-3.4-2.3 1a7 7 0 0 0-2-1.2L14 3h-4l-.6 2.7a7 7 0 0 0-2 1.2l-2.3-1-2 3.4 2 1.5A7 7 0 0 0 5 12c0 .4 0 .8.1 1.2l-2 1.5 2 3.4 2.3-1a7 7 0 0 0 2 1.2L10 21h4l.6-2.7a7 7 0 0 0 2-1.2l2.3 1 2-3.4-2-1.5c.1-.4.1-.8.1-1.2z"/></svg>Settings</a>
            </nav>

            @* ---- Task 9: Upstox daily token, shown/updated on every page ---- *@
            <div class="ct-token">
                <div class="ct-token-title">Upstox token</div>
                <div id="tokenWidget"
                     data-status-url="@WorkerEndpoints.TokenStatusUrl"
                     data-authorize-url="@WorkerEndpoints.TokenAuthorizeUrl"
                     data-hub-url="@WorkerEndpoints.PositionsHubUrl">
                    <span class="ct-sub">Checking token...</span>
                </div>
            </div>
        </aside>

        <main class="ct-main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/token.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

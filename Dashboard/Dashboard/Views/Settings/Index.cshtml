@model SettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<header class="ct-head">
    <div>
        <div class="ct-eyebrow">Worker configuration</div>
        <h1 class="ct-title">Settings</h1>
    </div>
    @if (Model.Sections.Count > 0)
    {
        <button type="submit" form="settingsForm" class="ct-btn ct-btn-primary border-0">Save &amp; apply</button>
    }
</header>

@if (Model.Message is not null)
{
    <div class="alert alert-success py-2 mb-0" role="alert">@Model.Message</div>
}
@if (Model.Warning is not null)
{
    <div class="alert alert-warning py-2 mb-0" role="alert">@Model.Warning</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger py-2 mb-0" role="alert">@Model.Error</div>
}

@if (Model.Sections.Count > 0)
{
    <form method="post" asp-controller="Settings" asp-action="Save" id="settingsForm" class="d-flex flex-column gap-3">
        <input type="hidden" name="tab" id="activeTab" value="@Model.ActiveTab" />

        <div class="ct-seg align-self-start" role="tablist">
            @foreach (var sec in Model.Sections)
            {
                var active = sec.Name == Model.ActiveTab;
                <button class="nav-link @(active ? "active" : "")" type="button" role="tab"
                        data-bs-toggle="tab" data-bs-target="#tab-@sec.Name" data-tab-name="@sec.Name">
                    @sec.Name
                    @if (sec.ReadOnly)
                    {
                        <span class="ct-locked">read-only</span>
                    }
                    @if (sec.ErrorCount > 0)
                    {
                        <span class="badge text-bg-danger ms-1">@sec.ErrorCount</span>
                    }
                </button>
            }
        </div>

        <div class="ct-notice">
            Items tagged <span class="ct-badge-restart" style="margin-left:0">restart required</span> are only read when the Worker starts.
        </div>

        <div class="tab-content">
            @foreach (var sec in Model.Sections)
            {
                var active = sec.Name == Model.ActiveTab;
                <div class="tab-pane fade @(active ? "show active" : "")" id="tab-@sec.Name" role="tabpanel">
                    @if (sec.ReadOnly)
                    {
                        <div class="ct-notice mb-3">Upstox settings are read-only here. Only Telegram and Strategy settings can be changed from the dashboard.</div>
                    }
                    @foreach (var group in sec.Groups)
                    {
                        <div class="ct-card ct-set-card">
                            <div class="ct-set-head">@group.Name</div>
                            @foreach (var item in group.Items)
                            {
                                var name = $"values[{item.Id}]";
                                <div class="ct-set-row">
                                    <div class="ct-set-label">
                                        <b>
                                            <label for="s-@item.Id" class="mb-0">@item.Key</label>
                                            @if (item.RequiresRestart)
                                            {
                                                <span class="ct-badge-restart" title="Only read when the Worker starts">restart required</span>
                                            }
                                        </b>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <small>@item.Description</small>
                                        }
                                    </div>
                                    <div>
                                        @if (item.ValueType == "bool")
                                        {
                                            <select class="ct-input @(item.Error is not null ? "is-invalid" : "")" id="s-@item.Id" name="@name" disabled="@item.ReadOnly">
                                                <option value="true" selected="@(item.Value == "true")">true</option>
                                                <option value="false" selected="@(item.Value != "true")">false</option>
                                            </select>
                                        }
                                        else if (item.IsSecret)
                                        {
                                            <div class="d-flex gap-2">
                                                <input type="password" class="ct-input @(item.Error is not null ? "is-invalid" : "")"
                                                       style="min-width:300px" id="s-@item.Id" name="@name" value="@item.Value" autocomplete="off" disabled="@item.ReadOnly" />
                                                @if (!item.ReadOnly)
                                                {
                                                    <button class="ct-btn" type="button" data-toggle-secret="s-@item.Id">Show</button>
                                                }
                                            </div>
                                        }
                                        else if (item.ValueType is "int" or "double")
                                        {
                                            <input type="number" step="@(item.ValueType == "int" ? "1" : "any")"
                                                   class="ct-input text-end @(item.Error is not null ? "is-invalid" : "")"
                                                   style="width:120px" id="s-@item.Id" name="@name" value="@item.Value" disabled="@item.ReadOnly" />
                                        }
                                        else
                                        {
                                            <input type="text" class="ct-input @(item.Error is not null ? "is-invalid" : "")"
                                                   style="min-width:300px" id="s-@item.Id" name="@name" value="@item.Value" autocomplete="off" disabled="@item.ReadOnly" />
                                        }
                                        @if (item.Error is not null)
                                        {
                                            <div class="small mt-1" style="color:var(--loss-ink)">@item.Error</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="settings-savebar">
            <button type="submit" class="ct-btn ct-btn-primary border-0">Save &amp; apply</button>
            <span class="ct-sub">Changes are applied to the running Worker immediately, except settings marked "restart required".</span>
        </div>
    </form>
}

@section Scripts {
    <script>
        document.querySelectorAll('[data-tab-name]').forEach(function (btn) {
            btn.addEventListener('shown.bs.tab', function () {
                document.getElementById('activeTab').value = btn.getAttribute('data-tab-name');
            });
        });
        document.querySelectorAll('[data-toggle-secret]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.getAttribute('data-toggle-secret'));
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.textContent = show ? 'Hide' : 'Show';
            });
        });
    </script>
}

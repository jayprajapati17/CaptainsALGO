@model SignalsViewModel
@{
    ViewData["Title"] = "Signals Log";
}
@functions {
    string Link(string? strategy = null, string? outcome = null, string? period = null, int page = 1) =>
        Url.Action("Index", "Signals", new
        {
            strategy = strategy ?? Model.StrategyFilter,
            outcome = outcome ?? Model.Outcome,
            period = period ?? Model.Period,
            page
        })!;

    string Chip(bool active) => active ? "chip chip-active" : "chip";

    string StrategyClass(AlgoData.Models.StrategyType s) => s switch
    {
        AlgoData.Models.StrategyType.Breakout => "st-chip st-breakout",
        AlgoData.Models.StrategyType.Macd => "st-chip st-macd",
        AlgoData.Models.StrategyType.Reversal => "st-chip st-reversal",
        _ => "st-chip st-ema"
    };
}

<header class="ct-head">
    <div>
        <div class="ct-eyebrow">Every signal, taken or skipped</div>
        <h1 class="ct-title">Signals Log</h1>
    </div>
</header>

@if (Model.Error is not null)
{
    <div class="alert alert-warning py-2 mb-0" role="alert">@Model.Error</div>
}

<section class="ct-card ct-filterbar">
    <div class="chip-group">
        <span class="chip-label">Strategy</span>
        <a class="@Chip(Model.StrategyFilter == "all")" href="@Link(strategy: "all")">All</a>
        <a class="@Chip(Model.StrategyFilter == "ema")" href="@Link(strategy: "ema")">EMA</a>
        <a class="@Chip(Model.StrategyFilter == "breakout")" href="@Link(strategy: "breakout")">Breakout</a>
        <a class="@Chip(Model.StrategyFilter == "macd")" href="@Link(strategy: "macd")">MACD</a>
            <a class="@Chip(Model.StrategyFilter == "reversal")" href="@Link(strategy: "reversal")">Reversal</a>
    </div>
    <div class="chip-group">
        <span class="chip-label">Outcome</span>
        <a class="@Chip(Model.Outcome == "all")" href="@Link(outcome: "all")">All</a>
        <a class="@Chip(Model.Outcome == "opened")" href="@Link(outcome: "opened")">Opened</a>
        <a class="@Chip(Model.Outcome == "skipped")" href="@Link(outcome: "skipped")">Skipped</a>
    </div>
    <div class="chip-group">
        <span class="chip-label">Period</span>
        <a class="@Chip(Model.Period == "today")" href="@Link(period: "today")">Today</a>
        <a class="@Chip(Model.Period == "7d")" href="@Link(period: "7d")">7 days</a>
        <a class="@Chip(Model.Period == "30d")" href="@Link(period: "30d")">30 days</a>
        <a class="@Chip(Model.Period == "all")" href="@Link(period: "all")">All time</a>
    </div>
</section>

@if (Model.Rows.Count == 0)
{
    <div class="ct-card empty-state">
        @if (Model.Error is null)
        {
            @:No signals match this filter.
        }
        else
        {
            @:Could not load data.
        }
    </div>
}
else
{
    <div class="ct-card ct-table-wrap">
        <table class="ct-table ct-compact">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Strategy</th>
                    <th>Signal</th>
                    <th>Confidence</th>
                    <th class="text-end">Nifty spot</th>
                    <th>Details</th>
                    <th>Outcome</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="text-nowrap">
                            <div class="num fw-semibold" style="font-size:14px">@r.SignalTime.ToString("hh:mm tt")</div>
                            <div class="ct-sub">@r.SignalTime.ToString("dd MMM")</div>
                        </td>
                        <td><span class="@StrategyClass(r.Strategy)">@Display.Strategy(r.Strategy)</span></td>
                        <td class="text-nowrap">
                            <span class="fw-semibold @(Display.IsBullish(r.Direction) ? "dir-up" : "dir-down")">
                                <span class="dir-dot">@(Display.IsBullish(r.Direction) ? "▲" : "▼")</span>@Display.DirectionLabel(r.Direction)
                            </span>
                            @if (r.IsCatchUp)
                            {
                                <span class="out-pill out-skip ms-1" title="An older crossover that was still active when the bot started -- not a fresh live signal.">Catch-up</span>
                            }
                        </td>
                        <td>
                            @if (r.Confidence is not null)
                            {
                                <span style="font-size:13px;font-weight:500">@r.Confidence</span>
                            }
                            else
                            {
                                <span class="ct-sub">&mdash;</span>
                            }
                        </td>
                        <td class="text-end text-nowrap num" style="font-size:14px">@Display.Number(r.SpotPrice)</td>
                        <td class="ct-sub text-nowrap" style="font-size:13px">
                            @if (r.AdxAtSignal is not null)
                            {
                                <span>ADX @r.AdxAtSignal.Value.ToString("0.0")</span>
                                if (r.AdxNCandlesAgo is not null)
                                {
                                    <span> (was @r.AdxNCandlesAgo.Value.ToString("0.0"))</span>
                                }
                            }
                            else if (r.BrokenLevel is not null)
                            {
                                <span>Level @Display.Number(r.BrokenLevel.Value)</span>
                            }
                            else
                            {
                                <span>&mdash;</span>
                            }
                        </td>
                        <td>
                            @if (r.PositionOpened)
                            {
                                <span class="out-pill">Opened</span>
                                if (r.PositionId is not null)
                                {
                                    <span class="ct-sub ms-1">#@r.PositionId</span>
                                }
                            }
                            else
                            {
                                <span class="out-pill out-skip">Skipped</span>
                                if (!string.IsNullOrWhiteSpace(r.SkipReason))
                                {
                                    <div class="ct-sub reason-cell mt-1" title="@r.SkipReason">@r.SkipReason</div>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="@(new PagerModel(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize, p => Link(page: p)))" />
}
